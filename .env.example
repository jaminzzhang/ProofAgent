# Optional provider credentials for future non-deterministic model providers.
# The deterministic v1 demo does not require API keys.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
ANTHROPIC_API_KEY=

# Optional trusted remote Knowledge Source adapter credentials.
# Use env var references such as PA_KNOWLEDGE_TOKEN in http_json header_env_refs.
PA_KNOWLEDGE_TOKEN=

# Private Hybrid Knowledge model-serving plane (secret-free internal service origins).
# Keep disabled for the deterministic local/demo path. When enabled, every value is required.
PA_HYBRID_KNOWLEDGE_MODELS_ENABLED=0
PA_KNOWLEDGE_MODEL_SCHEDULER_ENDPOINT=
PA_KNOWLEDGE_MODEL_SCHEDULER_NAMESPACE=
PA_KNOWLEDGE_MODEL_ALLOWED_HOSTS=
PA_KNOWLEDGE_MODEL_ALLOWED_CIDRS=
PA_KNOWLEDGE_DOCLING_ENDPOINT=
PA_KNOWLEDGE_PADDLE_ENDPOINT=
PA_KNOWLEDGE_EMBEDDING_ENDPOINT=
PA_KNOWLEDGE_RERANKER_ENDPOINT=
PA_KNOWLEDGE_PARSER_REVISION=
PA_KNOWLEDGE_MODEL_DIGESTS=
PA_KNOWLEDGE_PARSER_CONFIGURATION_SHA256=
PA_KNOWLEDGE_REQUIRE_INSURANCE_METADATA_DRAFTS=0

# Production application/worker composition. Values are identifiers, origins, paths,
# or Secret Handles; raw secret values stay in Vault or workload credentials.
PROOF_AGENT_MODE=development
PROOF_AGENT_POSTGRES_DSN=
PROOF_AGENT_STABLE_ORIGIN=
PROOF_AGENT_RELEASE_ID=
PROOF_AGENT_RELEASE_SCHEMA=
PROOF_AGENT_IMAGE_DIGEST=
PROOF_AGENT_DEPLOYMENT_SLOT=
PROOF_AGENT_ACTIVATION_STATE=
PROOF_AGENT_DEPLOYMENT_COMPATIBILITY_MANIFEST=
PROOF_AGENT_PUBLISHED_AGENT_CACHE_DIR=
PROOF_AGENT_EXECUTOR_WORK_DIR=
PROOF_AGENT_EXECUTOR_ID=
PROOF_AGENT_KNOWLEDGE_WORKER_ID=
PROOF_AGENT_ARTIFACT_S3_BUCKET=
PROOF_AGENT_ARTIFACT_S3_KEY_PREFIX=
PROOF_AGENT_ARTIFACT_S3_ENDPOINT=
PROOF_AGENT_ARTIFACT_S3_REGION=

# Exact Vault KV v2 deployment binding and opaque handle-to-locator mapping.
PROOF_AGENT_SECRET_PROVIDER_COMPATIBILITY_INPUT=
PROOF_AGENT_SECRET_HANDLE_LOCATORS_JSON=
PROOF_AGENT_SECRET_PROBE_HANDLE=
PROOF_AGENT_VAULT_AGENT_TOKEN_FILE=
PROOF_AGENT_OPENSEARCH_SECRET_HANDLE=
PROOF_AGENT_KNOWLEDGE_EVALUATION_SECRET_HANDLE=

# OIDC-only operator sessions and immutable deployment recovery mapping.
PROOF_AGENT_RECOVERY_GROUP_CLAIM=groups
PROOF_AGENT_RECOVERY_GROUP_NAME=
PROOF_AGENT_SESSION_ENVELOPE_KEY_HANDLES_JSON=
PROOF_AGENT_SESSION_ACTIVE_KEY_VERSION=
PROOF_AGENT_CSRF_KEY_HANDLE=
PROOF_AGENT_OIDC_CLIENT_SECRET_HANDLE=
PROOF_AGENT_OIDC_ISSUER=
PROOF_AGENT_OIDC_AUTHORIZATION_ENDPOINT=
PROOF_AGENT_OIDC_TOKEN_ENDPOINT=
PROOF_AGENT_OIDC_JWKS_URI=
PROOF_AGENT_OIDC_CLIENT_ID=
PROOF_AGENT_OIDC_GROUPS_CLAIM=groups
PROOF_AGENT_OIDC_ROLES_CLAIM=roles

# Server-owned validation identity/scope for the final Phase F Agent publication.
PROOF_AGENT_RELEASE_WORK_DIR=
PROOF_AGENT_RELEASE_INSTITUTION_AUTHORIZATION_JSON=
PROOF_AGENT_RELEASE_ACTOR_SUBJECT=
PROOF_AGENT_RELEASE_ACTOR_IDENTITY_PROVIDER=
PROOF_AGENT_RELEASE_ACTOR_SESSION_ID=

# Production Hybrid Knowledge data plane. This is a separate explicit activation switch;
# it also requires PA_HYBRID_KNOWLEDGE_MODELS_ENABLED=1 and every private model value above.
PA_HYBRID_PRODUCTION_RUNTIME_ENABLED=0
HYBRID_POSTGRES_DSN=
HYBRID_S3_BUCKET=
HYBRID_S3_KEY_PREFIX=
HYBRID_S3_ENDPOINT=
HYBRID_S3_REGION=
HYBRID_S3_ALLOW_INSECURE_ENDPOINT=0
# S3 credentials use the standard AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY variables or workload IAM.
HYBRID_OPENSEARCH_ENDPOINT=
HYBRID_OPENSEARCH_ALLOWED_HOSTS=
HYBRID_OPENSEARCH_ALLOWED_CIDRS=
HYBRID_OPENSEARCH_NUMBER_OF_REPLICAS=1
# These selectors name environment variables containing secret values/paths; do not put secrets here.
HYBRID_OPENSEARCH_AUTHORIZATION_ENV=
HYBRID_OPENSEARCH_CLIENT_CERT_PATH_ENV=
HYBRID_OPENSEARCH_CLIENT_KEY_PATH_ENV=
HYBRID_OPENSEARCH_CA_BUNDLE_PATH_ENV=
HYBRID_EMBEDDING_INSTRUCTION=
HYBRID_EMBEDDING_MODEL_REVISION=
HYBRID_EMBEDDING_DIMENSION=
HYBRID_RERANKER_REVISION=
HYBRID_RETRIEVAL_PROFILE_REVISION=
HYBRID_CONDITION_TAXONOMY_JSON=
# Explicit business-approved scope; there is intentionally no implicit PUBLIC default.
HYBRID_APPROVED_VISIBILITY_JSON=
HYBRID_LEXICAL_BUDGET=50
HYBRID_DENSE_BUDGET=50
HYBRID_RRF_WINDOW=50
HYBRID_RERANK_BUDGET=20
HYBRID_FINAL_BUDGET=10
HYBRID_RRF_RANK_CONSTANT=60
HYBRID_EMBEDDING_TIMEOUT_SECONDS=30

# Disposable Hybrid Knowledge integration and recovery evidence only.
# Never set these markers for production repositories or buckets.
HYBRID_TEST_POSTGRES_DSN=
HYBRID_TEST_S3_ENDPOINT=
HYBRID_TEST_S3_BUCKET=proof-agent-test
HYBRID_TEST_S3_ACCESS_KEY=
HYBRID_TEST_S3_SECRET_KEY=
HYBRID_TEST_OPENSEARCH_URL=
HYBRID_TEST_DISPOSABLE_MARKER=0
HYBRID_TEST_REPOSITORY_MARKER=
HYBRID_TEST_BUCKET_MARKER=
HYBRID_TEST_SOURCE_ID=
HYBRID_TEST_GENERATION_ID=
PA_KNOWLEDGE_CAPACITY_DRIVER=
PA_KNOWLEDGE_RECOVERY_DRIVER=
PA_KNOWLEDGE_SHADOW_DRIVER=
PA_KNOWLEDGE_ACCEPTANCE_DRIVER=
PA_KNOWLEDGE_ACCEPTANCE_VERIFIER=
PA_KNOWLEDGE_OPERATIONS_PROVIDER=
PA_KNOWLEDGE_RELEASE_AUTHORITY=

# Private production Knowledge evaluation/operations service.
# Driver selectors use `private-http`; the verifier selector uses `hmac-sha256`.
PA_KNOWLEDGE_EVALUATION_ENDPOINT=
PA_KNOWLEDGE_EVALUATION_ALLOWED_HOSTS=
PA_KNOWLEDGE_EVALUATION_ALLOWED_CIDRS=
PA_KNOWLEDGE_EVALUATION_TOKEN=
PA_KNOWLEDGE_EVALUATION_TIMEOUT_SECONDS=30
PA_KNOWLEDGE_ACCEPTANCE_EVALUATOR_IDS=
PA_KNOWLEDGE_ACCEPTANCE_TRUSTED_KEY_ID=
PA_KNOWLEDGE_ACCEPTANCE_HMAC_SECRET=
