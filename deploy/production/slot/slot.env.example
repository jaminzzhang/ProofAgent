# Candidate-local copy only. This example contains identifiers, credential-free
# origins, Secret Handles and container paths; never put raw secret values here.
PROOF_AGENT_MODE=production
PROOF_AGENT_POSTGRES_DSN=postgresql://proofagent@postgresql.internal.example/proofagent?sslmode=verify-full
PROOF_AGENT_STABLE_ORIGIN=https://proof-agent.invalid
PROOF_AGENT_RELEASE_ID=replace-with-candidate-release-id
PROOF_AGENT_RELEASE_SCHEMA=0021_metadata_workbook_v2
PROOF_AGENT_IMAGE_DIGEST=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
PROOF_AGENT_DEPLOYMENT_SLOT=blue
PROOF_AGENT_ACTIVATION_STATE=standby
PROOF_AGENT_DEPLOYMENT_COMPATIBILITY_MANIFEST=/run/configs/deployment-compatibility-manifest.json
PROOF_AGENT_PUBLISHED_AGENT_CACHE_DIR=/var/lib/proofagent/published-agent-cache
PROOF_AGENT_RELEASE_BUNDLE_CACHE_DIR=/var/lib/proofagent/release-bundle-cache
PROOF_AGENT_RELEASE_TRUSTED_ED25519_KEYS_JSON={"replace-with-key-id":"replace-with-base64-raw-public-key"}
PROOF_AGENT_EXECUTOR_WORK_DIR=/var/lib/proofagent/executor
PROOF_AGENT_EXECUTOR_ID=replace-with-slot-executor-id
PROOF_AGENT_KNOWLEDGE_WORKER_ID=replace-with-slot-knowledge-worker-id
PROOF_AGENT_ARTIFACT_S3_BUCKET=replace-with-production-bucket
PROOF_AGENT_ARTIFACT_S3_KEY_PREFIX=proofagent/
PROOF_AGENT_ARTIFACT_S3_ENDPOINT=https://s3.internal.example
PROOF_AGENT_ARTIFACT_S3_REGION=replace-with-region
PROOF_AGENT_SECRET_PROVIDER_COMPATIBILITY_INPUT=/run/configs/vault-compatibility.json
PROOF_AGENT_SECRET_HANDLE_LOCATORS_JSON={"models/proof-agent/insurance-primary":{"mount":"proof-agent","path":"models/insurance-primary","field":"credential"}}
PROOF_AGENT_SECRET_PROBE_HANDLE=operations/readiness-probe
PROOF_AGENT_VAULT_AGENT_TOKEN_FILE=/run/secrets/vault-agent-token
PROOF_AGENT_OPENSEARCH_SECRET_HANDLE=knowledge/opensearch
PROOF_AGENT_KSS_MANAGEMENT_ENDPOINT=https://knowledge-source-service.internal.example
PROOF_AGENT_KSS_OPERATOR_SECRET_HANDLE=knowledge/source-service/operator
PROOF_AGENT_KNOWLEDGE_EVALUATION_SECRET_HANDLE=evaluation/knowledge
PROOF_AGENT_RECOVERY_GROUP_CLAIM=groups
PROOF_AGENT_RECOVERY_GROUP_NAME=replace-with-recovery-group
PROOF_AGENT_SESSION_ENVELOPE_KEY_HANDLES_JSON={"v1":"sessions/envelope-v1"}
PROOF_AGENT_SESSION_ACTIVE_KEY_VERSION=v1
PROOF_AGENT_CSRF_KEY_HANDLE=sessions/csrf-v1
PROOF_AGENT_OIDC_CLIENT_SECRET_HANDLE=oidc/proof-agent-client
PROOF_AGENT_OIDC_ISSUER=https://oidc.internal.example/realms/proofagent
PROOF_AGENT_OIDC_AUTHORIZATION_ENDPOINT=https://oidc.internal.example/realms/proofagent/protocol/openid-connect/auth
PROOF_AGENT_OIDC_TOKEN_ENDPOINT=https://oidc.internal.example/realms/proofagent/protocol/openid-connect/token
PROOF_AGENT_OIDC_JWKS_URI=https://oidc.internal.example/realms/proofagent/protocol/openid-connect/certs
PROOF_AGENT_OIDC_CLIENT_ID=proof-agent
PROOF_AGENT_OIDC_GROUPS_CLAIM=groups
PROOF_AGENT_OIDC_ROLES_CLAIM=roles
PROOF_AGENT_RELEASE_WORK_DIR=/var/lib/proofagent/release
PROOF_AGENT_RELEASE_INSTITUTION_AUTHORIZATION_JSON={"institution_ids":[],"department_ids":[],"region_ids":[],"product_line_ids":[],"channel_ids":[]}
PROOF_AGENT_RELEASE_ACTOR_SUBJECT=replace-with-release-actor
PROOF_AGENT_RELEASE_ACTOR_IDENTITY_PROVIDER=replace-with-oidc-issuer-id
PROOF_AGENT_RELEASE_ACTOR_SESSION_ID=replace-with-release-session-id
PA_HYBRID_PRODUCTION_RUNTIME_ENABLED=1
PA_HYBRID_KNOWLEDGE_MODELS_ENABLED=1
PA_KNOWLEDGE_REQUIRE_INSURANCE_METADATA_DRAFTS=1
PA_KNOWLEDGE_MODEL_SCHEDULER_ENDPOINT=https://models.internal.example/scheduler
PA_KNOWLEDGE_MODEL_SCHEDULER_NAMESPACE=proofagent-production
PA_KNOWLEDGE_MODEL_ALLOWED_HOSTS=models.internal.example
PA_KNOWLEDGE_MODEL_ALLOWED_CIDRS=10.0.0.0/8
PA_KNOWLEDGE_DOCLING_ENDPOINT=https://models.internal.example/docling
PA_KNOWLEDGE_PADDLE_ENDPOINT=https://models.internal.example/paddle
PA_KNOWLEDGE_EMBEDDING_ENDPOINT=https://models.internal.example/embedding
PA_KNOWLEDGE_RERANKER_ENDPOINT=https://models.internal.example/reranker
PA_KNOWLEDGE_PARSER_REVISION=replace-with-parser-revision
PA_KNOWLEDGE_MODEL_DIGESTS={"docling":"replace-with-digest","paddle":"replace-with-digest","embedding":"replace-with-digest","reranker":"replace-with-digest"}
PA_KNOWLEDGE_PARSER_CONFIGURATION_SHA256=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
HYBRID_POSTGRES_DSN=postgresql://proofagent@postgresql.internal.example/proofagent?sslmode=verify-full
HYBRID_S3_BUCKET=replace-with-production-bucket
HYBRID_S3_KEY_PREFIX=hybrid/
HYBRID_S3_ENDPOINT=https://s3.internal.example
HYBRID_S3_REGION=replace-with-region
HYBRID_S3_ALLOW_INSECURE_ENDPOINT=0
HYBRID_OPENSEARCH_ENDPOINT=https://opensearch.internal.example
HYBRID_OPENSEARCH_ALLOWED_HOSTS=opensearch.internal.example
HYBRID_OPENSEARCH_ALLOWED_CIDRS=10.0.0.0/8
HYBRID_OPENSEARCH_NUMBER_OF_REPLICAS=1
HYBRID_EMBEDDING_INSTRUCTION=Represent the insurance rule for retrieval.
HYBRID_EMBEDDING_MODEL_REVISION=replace-with-embedding-revision
HYBRID_EMBEDDING_DIMENSION=1024
HYBRID_RERANKER_REVISION=replace-with-reranker-revision
HYBRID_RETRIEVAL_PROFILE_REVISION=replace-with-profile-revision
HYBRID_CONDITION_TAXONOMY_JSON={"allowed_keys":[]}
HYBRID_APPROVED_VISIBILITY_JSON={"institution_ids":[],"department_ids":[],"region_ids":[],"product_line_ids":[],"channel_ids":[]}
HYBRID_LEXICAL_BUDGET=50
HYBRID_DENSE_BUDGET=50
HYBRID_RRF_WINDOW=50
HYBRID_RERANK_BUDGET=20
HYBRID_FINAL_BUDGET=10
HYBRID_RRF_RANK_CONSTANT=60
HYBRID_EMBEDDING_TIMEOUT_SECONDS=30
