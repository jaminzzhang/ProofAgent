{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Proof Agent Secret Provider Compatibility Input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_id",
    "product",
    "product_version",
    "endpoint_origin",
    "authentication_method",
    "contract_evidence"
  ],
  "properties": {
    "protocol_id": {"const": "hashicorp-vault-2.0-kv-v2"},
    "product": {"const": "HashiCorp Vault"},
    "product_version": {"pattern": "^2\\.0\\.[0-9]+$"},
    "endpoint_origin": {"type": "string", "format": "uri", "pattern": "^https://"},
    "authentication_method": {"const": "vault-agent-token-file"},
    "contract_evidence": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
