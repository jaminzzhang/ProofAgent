# Candidate-local, credential-free configuration. Secret values are mounted as
# external mode-0400 files by compose.yaml; never place them in this file.
KSS_POSTGRES_DSN_FILE=/run/secrets/kss-postgres-dsn
KSS_OBJECT_STORE_URI=s3://replace-with-versioned-bucket/knowledge-source-service
KSS_SEARCH_ENDPOINT=https://opensearch.internal.example
KSS_RELEASE_IDENTITY=replace-with-exact-kss-release-id
KSS_S3_ENDPOINT=https://s3.internal.example
KSS_S3_REGION=replace-with-region
KSS_S3_ACCESS_KEY_ID_FILE=/run/secrets/kss-s3-access-key-id
KSS_S3_SECRET_ACCESS_KEY_FILE=/run/secrets/kss-s3-secret-access-key
KSS_TLS_CA_FILE=/run/configs/internal-ca.pem
KSS_OPERATOR_ID=replace-with-operator-identity
KSS_OPERATOR_BEARER_TOKEN_FILE=/run/secrets/kss-operator-token
KSS_PROJECTION_ENCODER_ENDPOINT=https://knowledge-models.internal.example/v1/encode
KSS_PROJECTION_ENCODER_BEARER_TOKEN_FILE=/run/secrets/kss-projection-encoder-token
KSS_DENSE_ENCODER_REVISION=replace-with-exact-dense-revision
KSS_SPARSE_ENCODER_REVISION=replace-with-exact-sparse-revision
KSS_DENSE_DIMENSION=384
KSS_AGENTIC_CONTROLLER_ENDPOINT=https://knowledge-models.internal.example/v1/next
KSS_AGENTIC_CONTROLLER_BEARER_TOKEN_FILE=/run/secrets/kss-agentic-controller-token
KSS_OCR_ENDPOINT=https://knowledge-models.internal.example/v1/extract
KSS_OCR_BEARER_TOKEN_FILE=/run/secrets/kss-ocr-token
KSS_OCR_MODEL_REVISION=replace-with-exact-ocr-revision
KSS_QUERY_WORKER_ID=replace-with-query-executor-id
KSS_KNOWLEDGE_WORKER_ID=replace-with-knowledge-worker-id
