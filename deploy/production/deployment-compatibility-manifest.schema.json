{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://proofagent.local/schemas/deployment-compatibility-manifest.v1.json",
  "title": "Proof Agent Deployment Compatibility Manifest",
  "description": "Secret-free, candidate-bound identities and compatibility evidence for every concrete production dependency. Cross-field component, capability, origin, digest, and freshness rules are enforced by proof-agent deployment validate-compatibility.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "topology",
    "tls_required",
    "tool_mode",
    "components"
  ],
  "properties": {
    "schema_version": {"const": "proofagent.deployment-compatibility.v1"},
    "topology": {"const": "single_host_blue_green"},
    "tls_required": {"const": true},
    "tool_mode": {"enum": ["disabled", "read_only_https"]},
    "components": {
      "type": "array",
      "minItems": 6,
      "maxItems": 7,
      "items": {"$ref": "#/$defs/component"}
    }
  },
  "$defs": {
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component_id",
        "product",
        "product_version",
        "immutable_reference",
        "endpoint_origin",
        "authentication_method",
        "adapter_protocol_id",
        "tested_capabilities",
        "evidence"
      ],
      "properties": {
        "component_id": {
          "enum": [
            "postgresql",
            "s3",
            "oidc",
            "secret_provider",
            "gateway",
            "model_provider",
            "read_only_tool"
          ]
        },
        "product": {"type": "string", "minLength": 1, "maxLength": 128},
        "product_version": {"type": "string", "minLength": 1, "maxLength": 128},
        "immutable_reference": {"$ref": "#/$defs/immutable_reference"},
        "endpoint_origin": {
          "type": "string",
          "format": "uri",
          "pattern": "^(?:https|postgresql)://"
        },
        "authentication_method": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "adapter_protocol_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "tested_capabilities": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z0-9_]+$", "maxLength": 64}
        },
        "evidence": {"$ref": "#/$defs/evidence"}
      }
    },
    "immutable_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value"],
      "properties": {
        "kind": {"enum": ["sha256", "service_revision"]},
        "value": {"type": "string", "minLength": 8, "maxLength": 255}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_uri", "sha256", "length", "verified_at"],
      "properties": {
        "artifact_uri": {
          "type": "string",
          "pattern": "^artifact://sha256/[0-9a-f]{64}$"
        },
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "length": {"type": "integer", "minimum": 1, "maximum": 1073741824},
        "verified_at": {"type": "string", "format": "date-time"}
      }
    }
  }
}
